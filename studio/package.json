{
  "name": "apparel-design-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Apparel Design Studio: design hats and tees, preview a live mockup, export a 300 DPI print file and a mockup PNG.",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port ${PORT:-4173}",
    "typecheck": "tsc -b --noEmit",
    "start": "serve -s dist -l ${PORT:-4173}"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.58.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "serve": "^14.2.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
