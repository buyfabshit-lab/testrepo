      "id": "35017842-a02b-4d7e-ad3b-d0237289532d",
      "name": "POST /api/gang-runs/build",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        780,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "const esc = (v) => String(v ?? '').replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\nconst wrap = (title, body) => `<div style=\"font-family:Helvetica,Arial,sans-serif;max-width:560px;margin:0 auto;padding:24px;color:#111\"><h2 style=\"margin:0 0 16px\">${esc(title)}</h2>${body}<p style=\"margin-top:32px;color:#888;font-size:12px\">Midnight Fusion &middot; orders@midnightfusion.co</p></div>`;\nconst S = $('Secrets').first().json;\nconst appUrl = String(S.appUrl || '').replace(/\\/+$/, '');\nconst err = $input.first().json;\nconst msg = err.error ? (typeof err.error === 'string' ? err.error : JSON.stringify(err.error)) : JSON.stringify(err);\nreturn [{ json: { email: { to: S.justinEmail, subject: 'Nightly gang run failed', html: wrap('Nightly gang run failed', `<p>POST /api/gang-runs/build did not succeed.</p><pre style=\"white-space:pre-wrap\">${esc(msg)}</pre>`), text: msg } } }];\n"
      },
      "id": "40274d43-04d4-4a10-ab4c-d3baf6cea749",
      "name": "Failure email",
