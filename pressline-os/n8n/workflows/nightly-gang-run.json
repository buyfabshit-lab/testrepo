      ],
      "notes": "Credential-free fallback: if $env is disabled on this n8n, paste literal values here. appUrl = PRESSLINE_APP_URL."
    },
    {
      "parameters": {
        "jsCode": "// Sign outbound calls to the app: X-Pressline-Signature: t=<unix>,v1=<hmac sha256 hex of \"<t>.<rawBody>\">\nconst crypto = require('crypto');\nconst S = $('Secrets').first().json;\nlet secret; try { secret = $env.N8N_WEBHOOK_SECRET; } catch (e) { /* $env disabled */ }\nif (!secret) secret = S.secret;\nif (!secret) throw new Error('N8N_WEBHOOK_SECRET missing: set it in n8n env or in the Secrets node');\nconst appUrl = String(S.appUrl || 'https://pressline.up.railway.app').replace(/\\/+$/, '');\nconst n8nUrl = String(S.n8nUrl || 'https://deathcorps187.app.n8n.cloud').replace(/\\/+$/, '');\nconst items = $input.all();\nconst calls = [];\n// Pacific calendar date for run_date.\nconst run_date = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Los_Angeles', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());\ncalls.push({ path: '/api/gang-runs/build', body: { run_date } });\nreturn calls.filter(Boolean).map((c) => {\n  const method = String(c.method || 'POST').toUpperCase();\n  const raw = method === 'GET' ? '' : JSON.stringify(c.body ?? {});\n  const t = Math.floor(Date.now() / 1000);\n  const mac = crypto.createHmac('sha256', secret).update(`${t}.${raw}`).digest('hex');\n  const url = c.url || (appUrl + c.path);\n  return { json: { url, method, raw, signature: `t=${t},v1=${mac}`, meta: c.meta || {} } };\n});\n"
      },
      "id": "b0524925-f534-4a4b-aa46-6348e469a443",
      "name": "Sign: gang-run build",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        520,
        0
      ]
    },
    {
      "parameters": {
