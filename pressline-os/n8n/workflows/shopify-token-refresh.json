    {
      "parameters": {
        "jsCode": "const esc = (v) => String(v ?? '').replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\nconst wrap = (title, body) => `<div style=\"font-family:Helvetica,Arial,sans-serif;max-width:560px;margin:0 auto;padding:24px;color:#111\"><h2 style=\"margin:0 0 16px\">${esc(title)}</h2>${body}<p style=\"margin-top:32px;color:#888;font-size:12px\">Midnight Fusion &middot; orders@midnightfusion.co</p></div>`;\nconst S = $('Secrets').first().json;\nconst appUrl = String(S.appUrl || '').replace(/\\/+$/, '');\nconst err = $input.first().json;\nconst msg = err.error ? (typeof err.error === 'string' ? err.error : JSON.stringify(err.error)) : JSON.stringify(err);\nreturn [{ json: { email: { to: S.justinEmail, subject: 'Shopify token refresh failed', html: wrap('Shopify token refresh failed', `<pre style=\"white-space:pre-wrap\">${esc(msg)}</pre>`), text: msg } } }];\n"
      },
      "id": "efe354d3-dbda-43f4-aa26-9b28900239b3",
