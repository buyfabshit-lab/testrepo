      "notes": "Credential-free fallback: if $env is disabled on this n8n, paste literal values here. appUrl = PRESSLINE_APP_URL."
    },
    {
      "parameters": {
        "jsCode": "// Sign outbound calls to the app: X-Pressline-Signature: t=<unix>,v1=<hmac sha256 hex of \"<t>.<rawBody>\">\nconst crypto = require('crypto');\nconst S = $('Secrets').first().json;\nlet secret; try { secret = $env.N8N_WEBHOOK_SECRET; } catch (e) { /* $env disabled */ }\nif (!secret) secret = S.secret;\nif (!secret) throw new Error('N8N_WEBHOOK_SECRET missing: set it in n8n env or in the Secrets node');\nconst appUrl = String(S.appUrl || 'https://pressline.up.railway.app').replace(/\\/+$/, '');\nconst n8nUrl = String(S.n8nUrl || 'https://deathcorps187.app.n8n.cloud').replace(/\\/+$/, '');\nconst items = $input.all();\nconst calls = [];\n// The app mints the Shopify token via client-credentials and stores it. No n8n Shopify credential anywhere.\ncalls.push({ path: '/api/webhooks/n8n', body: { kind: 'shopify_refresh', requested_at: new Date().toISOString() } });\nreturn calls.filter(Boolean).map((c) => {\n  const method = String(c.method || 'POST').toUpperCase();\n  const raw = method === 'GET' ? '' : JSON.stringify(c.body ?? {});\n  const t = Math.floor(Date.now() / 1000);\n  const mac = crypto.createHmac('sha256', secret).update(`${t}.${raw}`).digest('hex');\n  const url = c.url || (appUrl + c.path);\n  return { json: { url, method, raw, signature: `t=${t},v1=${mac}`, meta: c.meta || {} } };\n});\n"
      },
      "id": "074a74a4-54a3-4d06-a92c-4c97cf8ef7c7",
      "name": "Sign: shopify_refresh",
