{
  "name": "second-brain",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A local-first AI second brain: everything you capture becomes a bubble you can drift through.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port ${PORT:-4174}",
    "typecheck": "tsc -b --noEmit",
    "start": "serve -s dist -l ${PORT:-4174}",
    "ingest": "node scripts/ingest-repos.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "serve": "^14.2.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vite": "^7.1.5"
  }
}
